# FRAME Backend Environment Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/kingsta

# JWT Secrets
JWT_SECRET=your_jwt_access_secret_key_minimum_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters

# Redis (Optional in local development; fallback in-memory store active when absent)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ImageKit Media Storage
IK_PUB_KEY=your_imagekit_public_key
IK_PRI_KEY=your_imagekit_private_key
IK_URL=https://ik.imagekit.io/your_imagekit_id

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Email Service (Nodemailer OAuth2)
GOOGLE_USER=your_email@gmail.com
GOOGLE_REFRESH_TOKEN=your_gmail_api_oauth_refresh_token
